# Switch between the in-memory demo root (default, no infra required) and
# Prisma-backed repositories. Set USE_PRISMA=true only once DATABASE_URL
# points at a reachable Postgres (Supabase free tier, for instance).
USE_PRISMA="false"

DATABASE_URL="postgresql://user:password@localhost:5432/mojo"

# Demo mode runs the hub (port 3003) and admin (port 3000) as two `next dev`
# servers. The admin app reads the application queue from the hub over this
# URL so a submission made on the hub shows up for admin review. Defaults to
# the README's hub dev port when unset; only override if your hub runs
# elsewhere (or with USE_PRISMA=true, where both apps share the database instead).
HUB_URL="http://localhost:3003"

# Server-to-server secret for the admin→hub demo bridge (`x-mojo-bridge`
# header on GET /api/applications and POST review). Demo default is
# `demo-bridge-dev-only`; set a real value in production.
INTERNAL_BRIDGE_SECRET="demo-bridge-dev-only"

# LiveKit Cloud — free Starter tier includes ~50k monthly minutes.
LIVEKIT_API_KEY=""
LIVEKIT_API_SECRET=""
LIVEKIT_URL="wss://mojo.livekit.cloud"

# Payment rails — Paystack test-mode keys are free and work without a bank.
PAYSTACK_SECRET_KEY=""

# Lab file storage — Supabase Storage (free). Without these the lab falls
# back to in-browser object URLs so the demo still runs.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""

# Notifications — Resend free tier (3k emails/month).
RESEND_API_KEY=""

# AI recaps — any OpenAI-compatible chat endpoint. Unset = the built-in demo
# summarizer (first 160 chars + fixed focus areas).
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_SUMMARY_MODEL="gpt-4o-mini"