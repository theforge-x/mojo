{
  "name": "mojo",
  "private": true,
  "version": "0.0.0",
  "description": "mojo — tutoring marketplace. Nx monorepo, Next.js apps, clean-architecture domain modules.",
  "scripts": {
    "dev:web": "nx dev web",
    "dev:admin": "nx dev admin",
    "build": "npm run lint:boundaries && nx run-many --target=build --all",
    "test": "nx run-many --target=test --all",
    "test:affected": "nx affected --target=test",
    "lint": "biome check . && npm run lint:boundaries",
    "lint:boundaries": "eslint \"libs/**/*.{ts,tsx,js,jsx}\" \"apps/**/*.{ts,tsx,js,jsx}\"",
    "format": "biome format --write .",
    "prisma:generate": "prisma generate --schema=prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema=prisma/schema.prisma"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@nx/eslint-plugin": "^20.3.0",
    "@nx/next": "^20.3.0",
    "@nx/vite": "^20.3.0",
    "@nx/workspace": "^20.3.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "nx": "^20.3.0",
    "prisma": "^6.1.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "@livekit/components-react": "^2.6.7",
    "@livekit/components-styles": "^1.1.4",
    "@prisma/client": "^6.1.0",
    "@radix-ui/react-collapsible": "^1.1.20",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.1.1",
    "@radix-ui/react-toggle-group": "^1.1.19",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tailwindcss/postcss": "^4.3.3",
    "bcryptjs": "^2.4.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "livekit-client": "^2.7.4",
    "livekit-server-sdk": "^2.9.4",
    "lucide-react": "^1.35.0",
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^2.6.0",
    "tailwindcss": "^4.3.3",
    "zod": "^3.24.1"
  }
}
