{
  "name": "mojo",
  "private": true,
  "version": "0.0.0",
  "description": "mojo — tutoring marketplace. Nx monorepo, Next.js apps, clean-architecture domain modules.",
  "scripts": {
    "dev:admin": "nx dev admin",
    "dev:hub": "nx dev hub --port 3003",
    "build": "npm run lint:boundaries && nx run-many --target=build --all",
    "test": "nx run-many --target=test --all",
    "test:affected": "nx affected --target=test",
    "lint": "biome check . && npm run lint:boundaries",
    "lint:boundaries": "eslint \"libs/**/*.{ts,tsx,js,jsx}\" \"apps/**/*.{ts,tsx,js,jsx}\"",
    "format": "biome format --write .",
    "prisma:generate": "prisma generate --schema=prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema=prisma/schema.prisma",
    "prisma:seed": "node prisma/seed.mjs"
  },
  "prisma": {
    "seed": "node prisma/seed.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@nx/eslint-plugin": "^23.1.2",
    "@nx/next": "^23.1.2",
    "@nx/vite": "^23.1.2",
    "@nx/vitest": "^23.1.2",
    "@nx/workspace": "^23.1.2",
    "@types/node": "^26.0.0",
    "@types/react": "^19.0.0",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.68.0",
    "@vitejs/plugin-react": "^6.1.1",
    "nx": "^23.1.2",
    "prisma": "^6.19.3",
    "typescript": "~5.9.3",
    "vite": "^8.0.0",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@livekit/components-react": "^2.6.7",
    "@livekit/components-styles": "^1.1.4",
    "@prisma/client": "^6.19.3",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-collapsible": "^1.1.20",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.1.1",
    "@radix-ui/react-toggle-group": "^1.1.19",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tailwindcss/postcss": "^4.3.3",
    "@teispace/next-themes": "^3.0.2",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "livekit-client": "^2.7.4",
    "livekit-server-sdk": "^2.9.4",
    "lucide-react": "^1.35.0",
    "next": "^16.3.3",
    "react": "^19.0.0",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.0"
  },
  "allowScripts": {
    "prisma@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "@prisma/client@6.19.3": true,
    "nx@23.1.2": true
  }
}
